; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Туманные острова"
config/description="Fog Isles — a cozy sandbox on the Pomor White Sea: sail, light beacons, push back the fog, build a homestead."
config/version="0.0.1"
run/main_scene="res://src/scenes/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Content="*res://src/autoload/content.gd"
Net="*res://src/autoload/net.gd"
Game="*res://src/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[internationalization]

locale/translations=PackedStringArray("res://i18n/ru.po", "res://i18n/en.po")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.682, 0.722, 0.733, 1)

[shader_globals]

fog_color={
"type": "vec4",
"value": Vector4(0.42, 0.48, 0.5, 1)
}
fog_density={
"type": "float",
"value": 0.018
}
fog_clear_0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_4={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_5={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_6={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fog_clear_7={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sea_time={
"type": "float",
"value": 0.0
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sun_glint={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sea_storm={
"type": "float",
"value": 0.0
}
